{
  "name": "aeroalert",
  "version": "1.0.0",
  "description": "Real-time overhead aircraft tracker and desktop notification system",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.aeroalert.app",
    "productName": "AeroAlert",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "public/**/*",
      "assets/**/*"
    ]
  }
}